# Deal Scanner — environment variables
#
# All adapters work without keys, but Target's RedSky needs a public client key.
# This key is the one Target.com itself uses in the browser and rotates occasionally.
# If you see auth errors from Target, grab the current key from a Target.com network
# request (look for `key=` on any redsky.target.com URL) and paste it here.

TARGET_REDSKY_KEY=9f36aeafbe60771e321a7cc95a78140772ab3e96

# Optional: comma-separated visitor_id used by RedSky. Leave blank to auto-generate.
TARGET_VISITOR_ID=

# Optional: set to "1" to force mock data even when adapters could fetch.
DEAL_SCANNER_MOCK=0

# Optional outbound timeout per adapter (ms).
DEAL_SCANNER_TIMEOUT_MS=8000
